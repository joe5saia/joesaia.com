{
  "name": "joesaia-com",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:wasm": "bash scripts/build-quality-wasm.sh",
    "test:rust": "cargo test --manifest-path wasm/quality-model/Cargo.toml",
    "preview": "astro preview",
    "editor": "node editor/server.mjs",
    "post:new": "node scripts/create-post.mjs",
    "test": "node --test",
    "deploy": "npm run build && wrangler pages deploy dist --project-name joesaia-com --branch main",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.6",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "wrangler": "^4.167.0"
  }
}
