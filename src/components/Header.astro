---
const navItems = [
  { href: "/", label: "About" },
  { href: "/writing/", label: "Writing" },
  { href: "/resume/", label: "Résumé" },
  { href: "/contact/", label: "Contact" },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);
---

<header class="site-header">
  <nav class="header-inner" aria-label="Primary">
    <a class="wordmark" href="/" aria-label="Joe Saia, home">
      <span class="wordmark-name">Joe Saia</span>
    </a>

    <ul class="header-nav">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid var(--line);
    background: rgba(7, 13, 16, 0.82);
    backdrop-filter: blur(16px);
  }

  .header-inner {
    display: flex;
    width: min(100%, var(--page-width));
    min-height: 5rem;
    margin: 0 auto;
    padding: 0 var(--gutter);
    align-items: center;
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .wordmark {
    display: inline-flex;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark-name {
    color: var(--bone);
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  .header-nav {
    display: flex;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(1rem, 2.4vw, 2.25rem);
    list-style: none;
  }

  .header-nav a {
    position: relative;
    display: block;
    padding: 0.55rem 0;
    color: var(--mist);
    font-size: 0.69rem;
    font-weight: 650;
    letter-spacing: 0.11em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 160ms ease;
  }

  .header-nav a::after {
    position: absolute;
    right: 0;
    bottom: 0.25rem;
    left: 0;
    height: 1px;
    background: var(--amber);
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .header-nav a:hover,
  .header-nav a[aria-current="page"] {
    color: var(--bone);
  }

  .header-nav a:hover::after,
  .header-nav a[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header-nav li:last-child a {
    border: 1px solid rgba(212, 122, 59, 0.48);
    padding: 0.65rem 0.85rem;
    color: var(--bone);
  }

  .header-nav li:last-child a::after {
    display: none;
  }

  .header-nav li:last-child a:hover,
  .header-nav li:last-child a[aria-current="page"] {
    border-color: var(--amber);
    color: var(--amber);
  }

  @media (max-width: 52rem) {
    .header-inner {
      min-height: auto;
      padding-top: 1rem;
      padding-bottom: 0.7rem;
      align-items: flex-start;
      flex-direction: column;
      gap: 0.8rem;
    }

    .header-nav {
      width: 100%;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .header-nav a {
      padding: 0.45rem 0;
      font-size: 0.59rem;
      letter-spacing: 0.07em;
    }

    .header-nav li:last-child a {
      padding: 0.45rem 0.55rem;
    }
  }

  @media (max-width: 28rem) {
    .header-nav a {
      font-size: 0.55rem;
    }
  }
</style>
