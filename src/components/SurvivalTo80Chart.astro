---
import chartData from "./SurvivalTo80Chart.data.json";

interface CohortSeries {
  cohort: number;
  probabilities: number[];
}

interface ChartVariant {
  className: string;
  height: number;
  id: string;
  margin: {
    bottom: number;
    left: number;
    right: number;
    top: number;
  };
  width: number;
  xTicks: number[];
  yTicks: number[];
}

const palette = [
  "#747985",
  "#858085",
  "#968477",
  "#a78a6c",
  "#b38c61",
  "#bf8d56",
  "#c78c4e",
  "#d49a5a",
  "#e0aa6a",
  "#edbd80",
];

const series: CohortSeries[] = chartData.series;
const tableAges = [0, 20, 40, 60, 70, 80];

const variants: ChartVariant[] = [
  {
    className: "hidden w-full sm:block",
    height: 460,
    id: "survival-chart-desktop",
    margin: { bottom: 54, left: 68, right: 18, top: 16 },
    width: 720,
    xTicks: [0, 10, 20, 30, 40, 50, 60, 70, 80],
    yTicks: [0, 20, 40, 60, 80, 100],
  },
  {
    className: "block w-full sm:hidden",
    height: 470,
    id: "survival-chart-mobile",
    margin: { bottom: 58, left: 54, right: 10, top: 16 },
    width: 360,
    xTicks: [0, 20, 40, 60, 80],
    yTicks: [0, 20, 40, 60, 80, 100],
  },
];

function xPosition(age: number, chart: ChartVariant): number {
  const plotWidth = chart.width - chart.margin.left - chart.margin.right;
  return chart.margin.left + (age / 80) * plotWidth;
}

function yPosition(probability: number, chart: ChartVariant): number {
  const plotHeight = chart.height - chart.margin.top - chart.margin.bottom;
  return chart.margin.top + (1 - probability / 100) * plotHeight;
}

function createPath(probabilities: number[], chart: ChartVariant): string {
  return probabilities
    .map((probability, age) => {
      const command = age === 0 ? "M" : "L";
      const x = xPosition(age, chart).toFixed(2);
      const y = yPosition(probability, chart).toFixed(2);
      return `${command}${x},${y}`;
    })
    .join(" ");
}
---

<figure
  class="not-prose my-10 rounded-xl border border-border bg-surface-raised p-4 sm:p-6"
>
  <figcaption>
    <h2 class="text-lg font-semibold text-text-heading sm:text-xl">
      A first ruler: the odds of reaching age 80
    </h2>
    <p class="mt-2 text-sm leading-relaxed text-text-secondary">
      Each line follows a birth cohort. The value at any age is the estimated
      chance of reaching 80, conditional on having already reached that age.
      This is the full remaining ceiling, not a forecast of what AI can deliver.
    </p>
  </figcaption>

  {
    variants.map((chart) => (
      <svg
        aria-labelledby={`${chart.id}-title ${chart.id}-description`}
        class={`${chart.className} mt-6 h-auto`}
        height={chart.height}
        role="img"
        viewBox={`0 0 ${chart.width} ${chart.height}`}
        width={chart.width}
      >
        <title id={`${chart.id}-title`}>
          Probability of reaching age 80 by age already reached and birth cohort
        </title>
        <desc id={`${chart.id}-description`}>
          Ten rising lines show birth cohorts from 1900 through 2020. The 1900
          cohort begins at about 27 percent at birth, the 1940 cohort at about
          52 percent, and the projected 2020 cohort at about 72 percent. Every
          line reaches 100 percent at age 80.
        </desc>

        {chart.yTicks.map((tick) => (
          <g>
            <line
              class="stroke-border"
              stroke-width="1"
              x1={chart.margin.left}
              x2={chart.width - chart.margin.right}
              y1={yPosition(tick, chart)}
              y2={yPosition(tick, chart)}
            />
            <text
              class="fill-text-muted text-xs"
              dominant-baseline="middle"
              text-anchor="end"
              x={chart.margin.left - 10}
              y={yPosition(tick, chart)}
            >
              {tick}%
            </text>
          </g>
        ))}

        {chart.xTicks.map((tick) => (
          <g>
            <line
              class="stroke-border"
              stroke-width="1"
              x1={xPosition(tick, chart)}
              x2={xPosition(tick, chart)}
              y1={chart.margin.top}
              y2={chart.height - chart.margin.bottom}
            />
            <text
              class="fill-text-muted text-xs"
              text-anchor="middle"
              x={xPosition(tick, chart)}
              y={chart.height - chart.margin.bottom + 23}
            >
              {tick}
            </text>
          </g>
        ))}

        {series.map((cohort, index) => (
          <path
            d={createPath(cohort.probabilities, chart)}
            fill="none"
            stroke={palette[index]}
            stroke-dasharray={cohort.cohort >= 1960 ? "7 5" : undefined}
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width={cohort.cohort === 2020 ? 2.75 : 2}
            vector-effect="non-scaling-stroke"
          />
        ))}

        <text
          class="fill-text-secondary text-xs font-medium"
          text-anchor="middle"
          x={(chart.margin.left + chart.width - chart.margin.right) / 2}
          y={chart.height - 7}
        >
          Age already reached
        </text>
        <text
          class="fill-text-secondary text-xs font-medium"
          text-anchor="middle"
          transform={`rotate(-90 15 ${(chart.margin.top + chart.height - chart.margin.bottom) / 2})`}
          x="15"
          y={(chart.margin.top + chart.height - chart.margin.bottom) / 2}
        >
          Chance of reaching 80
        </text>
      </svg>
    ))
  }

  <ul
    aria-label="Birth cohorts"
    class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2 text-xs text-text-secondary sm:grid-cols-5"
  >
    {
      series.map((cohort, index) => (
        <li class="flex items-center gap-2">
          <svg aria-hidden="true" height="8" viewBox="0 0 30 8" width="30">
            <line
              stroke={palette[index]}
              stroke-dasharray={cohort.cohort >= 1960 ? "7 5" : undefined}
              stroke-linecap="round"
              stroke-width={cohort.cohort === 2020 ? 2.75 : 2}
              x1="1"
              x2="29"
              y1="4"
              y2="4"
            />
          </svg>
          <span>{cohort.cohort}</span>
        </li>
      ))
    }
  </ul>

  <div
    class="mt-5 space-y-2 border-t border-border pt-4 text-xs leading-relaxed text-text-muted"
  >
    <p>
      Solid lines: cohorts that reached 80 by 2023. Dashed lines: cohorts whose
      results require projected future mortality.
    </p>
    <p>
      Source: <a
        class="text-accent underline decoration-accent/40 underline-offset-2 hover:text-accent-hover"
        href="https://www.ssa.gov/OACT/Downloadables/CY/index.html"
        >2026 Social Security Trustees cohort life tables</a
      >, Alternative II. Male and female tables are combined using SSA's
      1,050-to-1,000 birth weighting.
    </p>
  </div>

  <div class="sr-only">
    <table>
      <caption>
        Probability of reaching age 80 at selected ages, by birth cohort
      </caption>
      <thead>
        <tr>
          <th scope="col">Birth cohort</th>
          {tableAges.map((age) => <th scope="col">Age {age}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          series.map((cohort) => (
            <tr>
              <th scope="row">{cohort.cohort}</th>
              {tableAges.map((age) => (
                <td>{cohort.probabilities[age].toFixed(1)} percent</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</figure>
