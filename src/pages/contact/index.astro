---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../../design-system/components/Button.astro";
import Eyebrow from "../../../design-system/components/Eyebrow.astro";
---

<BaseLayout
  title="Contact — Joe Saia"
  description="Get in touch with Joe Saia about engineering leadership, data teams, or AI-augmented development."
  wide
>
  <section class="page-intro" aria-labelledby="contact-title">
    <Eyebrow index="05">Open channel</Eyebrow>
    <div>
      <h1 class="page-title" id="contact-title">Contact</h1>
      <p class="page-dek">
        Looking for someone to lead a lean, AI-fluent engineering or data team,
        or just want to talk shop about autonomous teams, data platforms, or
        AI-augmented development? I'd love to hear from you.
      </p>
    </div>
  </section>

  <section class="contact-field" aria-labelledby="start-title">
    <div class="contact-prompt">
      <p class="contact-label">Best place to start</p>
      <h2 id="start-title">Send a note.</h2>
      <p>
        Email is the most direct route. Tell me what you're working on, what
        feels difficult, and where you think I might be useful.
      </p>
      <div class="contact-action">
        <Button href="mailto:joe5saia@gmail.com" variant="primary">
          Write to Joe
          <span slot="icon">↗</span>
        </Button>
      </div>
    </div>

    <div class="contact-routes">
      <a href="mailto:joe5saia@gmail.com" class="contact-route">
        <span class="route-number">01</span>
        <span class="route-name">Email</span>
        <span class="route-detail">joe5saia@gmail.com</span>
        <span class="route-arrow" aria-hidden="true">↗</span>
      </a>

      <a
        href="https://www.linkedin.com/in/joe-saia/"
        target="_blank"
        rel="noopener"
        class="contact-route"
      >
        <span class="route-number">02</span>
        <span class="route-name">LinkedIn</span>
        <span class="route-detail">Connect with me</span>
        <span class="route-arrow" aria-hidden="true">↗</span>
      </a>

      <a
        href="https://github.com/joe5saia/"
        target="_blank"
        rel="noopener"
        class="contact-route"
      >
        <span class="route-number">03</span>
        <span class="route-name">GitHub</span>
        <span class="route-detail">View my projects</span>
        <span class="route-arrow" aria-hidden="true">↗</span>
      </a>

      <div class="contact-route contact-route--static">
        <span class="route-number">04</span>
        <span class="route-name">Location</span>
        <span class="route-detail">West Orange, NJ</span>
        <span class="route-marker" aria-hidden="true">◆</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-field {
    display: grid;
    padding-top: clamp(3.5rem, 8vw, 7rem);
    grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(3.5rem, 9vw, 9rem);
  }

  .contact-prompt {
    align-self: start;
  }

  .contact-label {
    margin: 0;
    color: var(--copper);
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .contact-prompt h2 {
    margin: 1.25rem 0 0;
    color: var(--bone-bright);
    font-size: clamp(3rem, 5vw, 5rem);
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .contact-prompt > p:not(.contact-label) {
    max-width: 29rem;
    margin: 1.75rem 0 0;
    color: var(--mist);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .contact-action {
    margin-top: 2.25rem;
  }

  .contact-routes {
    border-top: 1px solid var(--line-bright);
  }

  .contact-route {
    display: grid;
    min-height: 7.5rem;
    padding: 1.5rem 0;
    grid-template-columns: 2.5rem minmax(7rem, 0.6fr) minmax(0, 1fr) 1.5rem;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .route-number {
    color: var(--copper);
    font-size: 0.59rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .route-name {
    color: var(--bone-bright);
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.8vw, 2.35rem);
    letter-spacing: -0.03em;
    transition: color 160ms ease;
  }

  .route-detail {
    overflow-wrap: anywhere;
    color: var(--mist-dim);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
  }

  .route-arrow,
  .route-marker {
    justify-self: end;
    color: var(--copper);
  }

  .route-arrow {
    font-size: 1.1rem;
    transition: transform 160ms ease;
  }

  .route-marker {
    font-size: 0.48rem;
  }

  a.contact-route:hover .route-name {
    color: var(--amber);
  }

  a.contact-route:hover .route-arrow {
    transform: translate(0.2rem, -0.2rem);
  }

  @media (max-width: 52rem) {
    .contact-field {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    .contact-route {
      grid-template-columns: 2rem minmax(0, 1fr) 1.5rem;
    }

    .route-detail {
      grid-column: 2 / -1;
      grid-row: 2;
    }

    .route-arrow,
    .route-marker {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
