---
import "../../design-system/tokens.css";
import Header from "../components/Header.astro";

const currentYear = new Date().getFullYear();
const title = "Joe Saia — Engineering & Data Leader";
const description =
  "Engineering and data leader. PhD economist. 15 years building software, data systems, and technical teams across healthtech, startups, AI, and the public sector.";
const canonical = new URL("/", Astro.site).toString();
const socialImage = new URL("/social-card.png", Astro.site).toString();
const personId = `${canonical}#person`;

const homepageJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "Joe Saia",
      url: canonical,
      jobTitle: "Engineering and data leader",
      sameAs: [
        "https://github.com/joe5saia/",
        "https://www.linkedin.com/in/joe-saia/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${canonical}#website`,
      url: canonical,
      name: "Joe Saia",
      description,
      inLanguage: "en-US",
      publisher: { "@id": personId },
    },
  ],
};

const careerTimeline = [
  {
    period: "2009–2013",
    title: "Physics Undergrad in Troy, NY",
    description:
      "Studied physics and economics at Rensselaer Polytechnic Institute, learning to move between mathematical models, empirical evidence, and real-world systems.",
  },
  {
    period: "2013–2014",
    title: "Economics Masters in London",
    description:
      "Focused on economic theory and quantitative methods at University College London, building a deeper foundation for applied research.",
  },
  {
    period: "2014–2016",
    title: "Data Engineer at Federal Reserve",
    description:
      "Joined the Fed’s most technical team—a self-taught group responsible for ingesting the financial data used across the institution—and learned on the fly alongside exceptionally smart, dedicated colleagues. It showed me the leverage a small team like that can create.",
  },
  {
    period: "2016–2021",
    title: "Economics PhD at Columbia",
    description:
      "Worked on macro-finance topics while going deep on Bayesian methods, causal inference, and economic modeling—and learning how to frame ambiguous questions precisely.",
  },
  {
    period: "2021",
    title: "ML Engineer at Revelio Labs",
    description:
      "Joined my first startup as one of its first 10 employees and went deep on building dynamic data pipelines for machine-learning models.",
  },
  {
    period: "2021–2024",
    title: "Data Scientist and Senior Manager at Perry Health",
    description:
      "At a lean Series A company, learned how to run a business from an exceptional non-technical leadership team—and grew from an individual contributor into a leader across technical teams.",
  },
  {
    period: "2024–2026",
    title: "Head of Engineering at Rhythm Management",
    description:
      "Served enterprise clients, solving larger-scale versions of Perry’s technical challenges while helping the organization reimagine itself as a collection of owners. The new challenge was not just scaling systems, but remaking how the business operated.",
  },
  {
    period: "2026–Now",
    title: "Founder and President at Unhistoric Acts",
    description:
      "Founded a 501(c)(3) civic software foundation to house Town Crier, an AI-assisted platform that enables agents to answer questions about local government.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070d10" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Joe Saia" />
    <meta property="og:image" content={socialImage} />
    <meta
      property="og:image:alt"
      content="Joe Saia social card with a mahogany library and sitting chair"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content="Joe Saia social card with a mahogany library and sitting chair"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Joe Saia — Writing"
      href="/rss.xml"
    />
    <title>{title}</title>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(homepageJsonLd)}
    />
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="ambient-field" aria-hidden="true">
      <svg
        class="ambient-current"
        viewBox="0 0 1440 2200"
        preserveAspectRatio="none"
        focusable="false"
      >
        <path
          class="current current--dim"
          d="M-80 230C228 74 358 382 625 291C882 203 913-8 1192 84C1420 159 1323 391 1512 464M-72 955C188 765 364 1135 615 963C821 821 770 600 1078 561C1313 532 1322 752 1518 686M-56 1806C242 1648 403 1982 676 1799C868 1670 814 1451 1115 1440C1337 1432 1399 1622 1510 1586"
        ></path>
        <path
          class="current current--live"
          d="M-80 230C228 74 358 382 625 291C882 203 913-8 1192 84C1420 159 1323 391 1512 464M-72 955C188 765 364 1135 615 963C821 821 770 600 1078 561C1313 532 1322 752 1518 686M-56 1806C242 1648 403 1982 676 1799C868 1670 814 1451 1115 1440C1337 1432 1399 1622 1510 1586"
        ></path>
      </svg>
    </div>

    <Header />

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <svg
          class="hero-current"
          viewBox="0 0 1400 760"
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M-65 599C184 490 303 716 534 581C766 445 674 184 961 137C1211 96 1298 332 1466 270"
          ></path>
          <circle cx="530" cy="583" r="4"></circle>
          <circle cx="959" cy="138" r="4"></circle>
        </svg>

        <p class="eyebrow hero-eyebrow">Technical leadership</p>

        <h1 id="hero-title">
          <span>Joe</span>
          <span class="hero-surname">Saia.</span>
        </h1>

        <p class="hero-coordinate">
          West Orange, New Jersey<br />
          <span>40.80° N · 74.24° W</span>
        </p>

        <div class="hero-intro">
          <p class="hero-lead">
            Building software, data systems, and teams for high-stakes,
            high-growth environments.
          </p>
          <p>
            I have 15 years of software and data experience across startups,
            healthtech, AI, and the public sector, as well as a PhD in
            economics. I’m passionate about building software and organizations
            that tackle complex problems.
          </p>
        </div>

        <p class="field-note">
          A study in distributed intelligence<br />
          <span>Explore · connect · adapt</span>
        </p>
      </section>

      <section id="about" class="section about" aria-labelledby="about-title">
        <header class="section-heading about-heading">
          <p class="eyebrow"><span>01</span> Depth, then range</p>
          <h2 id="about-title">Ideas should move through the whole system.</h2>
        </header>

        <div class="about-body">
          <article class="about-content">
            <p class="about-kicker">
              Complex problems need more than one lens.
            </p>
            <div class="about-copy">
              <p>
                Economics taught me to make assumptions explicit and separate
                signal from noise. Engineering taught me that a correct model
                only matters if it can survive contact with a real product,
                organization, and user.
              </p>
              <p>
                The work I enjoy most sits at those boundaries: technically
                difficult, operationally important, and too ambiguous for any
                one discipline to solve alone.
              </p>
            </div>
          </article>

          <aside class="range-note" aria-label="Areas of experience">
            <p>Range of motion</p>
            <ul>
              <li>Machine learning</li>
              <li>Technical strategy</li>
              <li>AI systems</li>
              <li>Cross-functional leadership</li>
              <li>Startup operations</li>
              <li>Bayesian methods</li>
            </ul>
          </aside>
        </div>
      </section>

      <section id="path" class="section proof" aria-labelledby="proof-title">
        <header class="section-heading proof-heading">
          <p class="eyebrow"><span>02</span> The path so far</p>
          <h2 id="proof-title">Built in layers.</h2>
          <p>
            Physical intuition, then economic reasoning, then data engineering,
            software, and the work of leading teams—each stage reframed the one
            before it.
          </p>
        </header>

        <ol class="career-timeline">
          {
            careerTimeline.map((step, index) => (
              <li class="career-step">
                <p class="career-period">{step.period}</p>
                <span class="career-node" aria-hidden="true" />
                <article>
                  <p class="career-index">
                    Current {String(index + 1).padStart(2, "0")}
                  </p>
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                </article>
              </li>
            ))
          }
        </ol>
      </section>

      <section
        id="thesis"
        class="section thesis"
        aria-labelledby="thesis-title"
      >
        <header class="section-heading thesis-heading">
          <p class="eyebrow"><span>03</span> Working thesis</p>
          <h2 id="thesis-title">What I Value in my Work</h2>
        </header>

        <div class="thesis-map">
          <svg
            class="thesis-current"
            viewBox="0 0 1000 1260"
            preserveAspectRatio="none"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M114-20C171 165 727 41 768 263C813 507 244 406 217 646C191 882 784 737 748 1017C724 1201 353 1110 354 1303"
            ></path>
          </svg>

          <ol>
            <li>
              <article>
                <p class="thesis-number">01 <span aria-hidden="true"></span></p>
                <h3>Teams that Value Ownership</h3>
                <p>
                  Teams and individuals that identify problems and own the work
                  to solve them.
                </p>
              </article>
            </li>
            <li>
              <article>
                <p class="thesis-number">02 <span aria-hidden="true"></span></p>
                <h3>Impact &amp; Mission</h3>
                <p>
                  I want to work with people who are trying to improve the
                  world.
                </p>
              </article>
            </li>
            <li>
              <article>
                <p class="thesis-number">03 <span aria-hidden="true"></span></p>
                <h3>Colleagues with Depth and Range</h3>
                <p>
                  I value colleagues I can learn from—people who challenge one
                  another, share what they know, and push each other to do
                  better work.
                </p>
              </article>
            </li>
            <li>
              <article>
                <p class="thesis-number">04 <span aria-hidden="true"></span></p>
                <h3>Pragmatic AI</h3>
                <p>
                  I have built AI tools inside production applications,
                  including triage assistants. I’m interested in what should be
                  automated, what should stay human, and how teams adapt around
                  both.
                </p>
              </article>
            </li>
          </ol>
        </div>
      </section>

      <section
        id="routes"
        class="section routes"
        aria-labelledby="routes-title"
      >
        <header class="section-heading routes-heading">
          <p class="eyebrow"><span>04</span> Continue outward</p>
          <h2 id="routes-title">Choose a current.</h2>
        </header>

        <nav class="route-list" aria-label="Explore my website">
          <a href="/writing/">
            <span class="route-number">01</span>
            <span class="route-name">Writing</span>
            <span class="route-detail"
              >Notes on engineering, data, AI, and leadership.</span
            >
            <span class="route-arrow" aria-hidden="true">↗</span>
          </a>
          <a href="/resume/">
            <span class="route-number">02</span>
            <span class="route-name">Résumé</span>
            <span class="route-detail"
              >Experience, education, and my full working history.</span
            >
            <span class="route-arrow" aria-hidden="true">↗</span>
          </a>
          <a href="/contact/">
            <span class="route-number">03</span>
            <span class="route-name">Contact</span>
            <span class="route-detail"
              >If this sounds like a team you are building, start here.</span
            >
            <span class="route-arrow" aria-hidden="true">↗</span>
          </a>
        </nav>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-lead">
        <p class="eyebrow">Joe Saia</p>
        <p>Engineering, data, and the teams behind them.</p>
      </div>

      <div class="footer-links">
        <a href="/writing/">Writing</a>
        <a
          href="https://github.com/joe5saia/"
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >
        <a
          href="https://www.linkedin.com/in/joe-saia/"
          target="_blank"
          rel="noopener noreferrer">LinkedIn</a
        >
      </div>

      <p class="copyright">© {currentYear} Joe Saia</p>
    </footer>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    overflow-x: clip;
    background: var(--ink);
  }

  body {
    min-width: 20rem;
    margin: 0;
    overflow-x: hidden;
    background:
      radial-gradient(
        circle at 76% 7%,
        rgba(212, 122, 59, 0.1),
        transparent 23rem
      ),
      radial-gradient(
        circle at 9% 32%,
        rgba(24, 63, 74, 0.28),
        transparent 31rem
      ),
      radial-gradient(
        circle at 88% 68%,
        rgba(27, 69, 76, 0.18),
        transparent 34rem
      ),
      var(--ink);
    color: var(--bone);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  body::before {
    position: fixed;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.24'/%3E%3C/svg%3E");
    content: "";
    opacity: 0.035;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible {
    border-radius: 2px;
    outline: 3px solid var(--amber);
    outline-offset: 5px;
  }

  ::selection {
    background: var(--copper);
    color: var(--ink);
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    top: 1rem;
    left: 1rem;
    padding: 0.75rem 1rem;
    background: var(--bone);
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: translateY(-180%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .ambient-field {
    position: absolute;
    z-index: 0;
    inset: 0 0 auto;
    height: 100%;
    min-height: 220rem;
    overflow: hidden;
    pointer-events: none;
  }

  .ambient-current {
    width: 100%;
    height: 100%;
    opacity: 0.64;
  }

  .current {
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .current--dim {
    stroke: rgba(212, 122, 59, 0.13);
    stroke-width: 1;
  }

  .current--live {
    stroke: var(--copper);
    stroke-dasharray: 2 84;
    stroke-linecap: round;
    stroke-width: 2;
    animation: drift 14.5s linear infinite;
    filter: drop-shadow(0 0 7px rgba(242, 164, 79, 0.72));
  }

  main,
  .site-footer {
    position: relative;
    z-index: 1;
  }

  main {
    width: min(100%, var(--page-width));
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto 1fr auto;
    min-height: calc(100svh - 5rem);
    padding: clamp(3rem, 7vh, 6.5rem) 0 clamp(4rem, 9vh, 8rem);
    isolation: isolate;
  }

  .hero-current {
    position: absolute;
    z-index: -1;
    inset: 6% -10% 0;
    width: 120%;
    height: 92%;
    overflow: visible;
  }

  .hero-current path {
    fill: none;
    stroke: rgba(212, 122, 59, 0.48);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }

  .hero-current circle {
    fill: var(--amber);
    filter: drop-shadow(0 0 12px rgba(242, 164, 79, 0.9));
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 4.2s ease-in-out infinite;
  }

  .hero-eyebrow {
    grid-column: 1 / 7;
    align-self: start;
    margin: 0;
  }

  .eyebrow {
    color: var(--copper);
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .eyebrow > span {
    display: inline-block;
    margin-right: 0.8rem;
    color: var(--mist-dim);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 400;
    text-wrap: balance;
  }

  h1 {
    grid-column: 1 / -1;
    align-self: center;
    margin: 0;
    font-size: clamp(6rem, 16.2vw, 15rem);
    letter-spacing: -0.065em;
    line-height: 0.67;
  }

  h1 span {
    display: block;
  }

  .hero-surname {
    margin-left: 21%;
    color: transparent;
    -webkit-text-stroke: 1px rgba(238, 230, 216, 0.58);
  }

  .hero-coordinate {
    grid-column: 1 / 4;
    align-self: end;
    margin: 0 0 0.6rem;
    color: var(--mist);
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.4;
  }

  .hero-coordinate span {
    color: var(--mist-dim);
    font-family: var(--font-sans);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-intro {
    grid-column: 7 / 12;
    align-self: end;
    max-width: 40rem;
    margin: 0 0 0 auto;
    color: var(--mist);
    font-size: clamp(0.95rem, 1.2vw, 1.08rem);
  }

  .hero-lead {
    margin-bottom: 1rem;
    color: var(--bone);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.8vw, 2.55rem);
    line-height: 1.17;
  }

  .field-note {
    position: absolute;
    top: 21%;
    right: 0;
    margin: 0;
    color: var(--mist);
    font-family: var(--font-display);
    font-size: 0.88rem;
    line-height: 1.35;
    transform: rotate(90deg) translateX(100%);
    transform-origin: top right;
  }

  .field-note span {
    color: var(--copper);
    font-family: var(--font-sans);
    font-size: 0.57rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section {
    position: relative;
    padding: clamp(7rem, 13vw, 13rem) 0;
  }

  .section + .section {
    border-top: 1px solid var(--line);
  }

  .section-heading {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0 clamp(1rem, 2vw, 2rem);
  }

  .section-heading .eyebrow {
    grid-column: 1 / 5;
    align-self: start;
    margin: 0;
  }

  .section-heading h2 {
    grid-column: 4 / 12;
    margin: 0;
    font-size: clamp(3.15rem, 6.6vw, 7.25rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .about-body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2rem;
    margin-top: clamp(5rem, 10vw, 10rem);
  }

  .about-content {
    grid-column: 1 / 10;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    gap: 2rem;
  }

  .about-kicker {
    grid-column: 1 / 4;
    margin: 0;
    color: var(--bone);
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.4vw, 2.25rem);
    line-height: 1.2;
  }

  .about-copy {
    grid-column: 4 / 10;
    color: var(--mist);
    font-size: clamp(1.05rem, 1.45vw, 1.25rem);
  }

  .about-copy p:first-child::first-letter {
    float: left;
    margin: 0.05em 0.12em 0 0;
    color: var(--copper);
    font-family: var(--font-display);
    font-size: 4.7em;
    line-height: 0.72;
  }

  .about-copy p:last-child {
    margin-bottom: 0;
  }

  .range-note {
    grid-column: 10 / -1;
    align-self: end;
    border-top: 1px solid var(--line-bright);
    padding-top: 1rem;
  }

  .range-note > p {
    margin-bottom: 1rem;
    color: var(--copper);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .range-note ul {
    margin: 0;
    padding: 0;
    color: var(--mist);
    font-size: 0.77rem;
    list-style: none;
  }

  .range-note li + li {
    margin-top: 0.65rem;
  }

  .proof-heading h2 {
    grid-column: 5 / -1;
  }

  .proof-heading > p:last-child {
    grid-column: 8 / -1;
    max-width: 35rem;
    margin: 2.5rem 0 0;
    color: var(--mist);
    font-size: 1rem;
  }

  .career-timeline {
    --date-column: clamp(7rem, 16vw, 13rem);
    --node-column: clamp(2.5rem, 5vw, 4.5rem);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(4rem, 7vw, 7rem);
    max-width: 79rem;
    margin-top: clamp(6rem, 11vw, 10rem);
    margin-right: auto;
    margin-left: auto;
    padding: 1rem 0;
    list-style: none;
  }

  .career-timeline::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--date-column) + var(--node-column) / 2);
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(212, 122, 59, 0.72) 3%,
      rgba(212, 122, 59, 0.3) 92%,
      transparent
    );
    content: "";
  }

  .career-step {
    position: relative;
    display: grid;
