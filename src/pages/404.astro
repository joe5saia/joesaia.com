---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../../design-system/components/Button.astro";
---

<BaseLayout
  title="Page Not Found — Joe Saia"
  description="The page you're looking for doesn't exist."
  noindex={true}
  wide
>
  <section class="error-field" aria-labelledby="error-title">
    <div class="error-signal" aria-hidden="true">
      <span>4</span>
      <svg viewBox="0 0 240 240" focusable="false">
        <circle cx="120" cy="120" r="91"></circle>
        <circle class="signal-orbit" cx="120" cy="120" r="91"></circle>
        <circle class="signal-core" cx="120" cy="120" r="7"></circle>
      </svg>
      <span>4</span>
    </div>

    <div class="error-copy">
      <p class="error-kicker"><span>Lost current</span> Error 404</p>
      <h1 id="error-title">This route drifted out of the field.</h1>
      <p>The page you're looking for doesn't exist or has been moved.</p>
      <div class="error-actions">
        <Button href="/" variant="primary">Return home</Button>
        <Button href="/writing/">Browse writing</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-field {
    display: grid;
    min-height: 58vh;
    grid-template-columns: minmax(18rem, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(3rem, 9vw, 9rem);
  }

  .error-signal {
    display: grid;
    grid-template-columns: 1fr minmax(8rem, 13rem) 1fr;
    align-items: center;
    color: var(--mist-dim);
    font-family: var(--font-display);
    font-size: clamp(5rem, 10vw, 10rem);
    line-height: 1;
  }

  .error-signal > span:last-child {
    text-align: right;
  }

  .error-signal svg {
    width: 100%;
    overflow: visible;
  }

  .error-signal circle {
    fill: none;
    stroke: var(--line-bright);
    stroke-width: 1;
  }

  .error-signal .signal-orbit {
    stroke: var(--copper);
    stroke-dasharray: 2 36;
    stroke-linecap: round;
    stroke-width: 2;
    animation: orbit-signal 14.5s linear infinite;
    transform-origin: center;
  }

  .error-signal .signal-core {
    fill: var(--amber);
    stroke: none;
    filter: drop-shadow(0 0 8px rgba(242, 164, 79, 0.7));
  }

  .error-kicker,
  .error-copy h1,
  .error-copy > p {
    margin: 0;
  }

  .error-kicker {
    color: var(--mist-dim);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .error-kicker span {
    margin-right: 1rem;
    color: var(--copper);
  }

  .error-copy h1 {
    max-width: 39rem;
    margin-top: 1.5rem;
    color: var(--bone-bright);
    font-size: clamp(3.2rem, 6vw, 6rem);
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .error-copy > p:not(.error-kicker) {
    margin-top: 1.75rem;
    color: var(--mist);
    font-size: 1rem;
  }

  .error-actions {
    display: flex;
    margin-top: 2.25rem;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  @keyframes orbit-signal {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 50rem) {
    .error-field {
      grid-template-columns: 1fr;
    }

    .error-signal {
      max-width: 34rem;
    }
  }
</style>
