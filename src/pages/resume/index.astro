---
import BaseLayout from "../../layouts/BaseLayout.astro";

const experience = [
  {
    company: "Rhythm Management Group",
    title: "VP of Engineering",
    dates: "Apr 2025 – Mar 2026",
    highlights: [
      "Reporting to the CEO, built and led a 26-person org spanning product engineering, platform engineering, QA, IT, and Salesforce analysts",
      "Co-owned the BI stack (Snowflake + Fivetran + Sigma) with VP of Finance; moved executive reporting to self-serve dashboards and established source-of-truth metrics",
      "Implemented Salesforce Omnichannel routing; measured a 35% productivity lift",
      "Hands-on contributor averaging 2–5 production PRs per week: built Python ETL for claims data into Salesforce and Snowflake, automating reconciliation and enabling claims funnel measurement",
    ],
  },
  {
    company: "Rhythm Management Group",
    title: "Director of Engineering",
    dates: "May 2024 – Apr 2025",
    highlights: [
      "Transformed a waterfall-in-disguise team into a high-agency agile org that shipped against customer pain points in days, not quarters",
      "Drove 99%+ uptime, moved releases from quarterly to bi-weekly, and consolidated backend services for 30% lower cloud spend",
      "Insourced key IT functions to improve reliability, security posture, and data governance",
    ],
  },
  {
    company: "Perry Health",
    title: "Senior Manager of Data and Engineering",
    dates: "May 2022 – May 2024",
    highlights: [
      "Reporting to the COO, owned the EHR web app and data infrastructure using Python and React; led a cross-functional team of engineers and data scientists across NY and EU",
      "Built acquisition-to-enrollment funnel (Rudderstack, GA4, Tableau), instrumented events, and ran A/B tests to improve conversion",
      "Built claims processing pipeline managing $1.5M per year enabling a two-person team; maintained industry-leading 74% collections rate",
      "Shipped data integrations (Abbott, Dexcom, SureScripts) to improve clinical decision-making",
    ],
  },
  {
    company: "Perry Health",
    title: "Data Scientist",
    dates: "Dec 2021 – May 2022",
    highlights: [
      "Migrated Python ETLs to Fivetran and dbt SQL on Redshift, enabling faster iteration",
      "Maintained comprehensive company-wide reporting on all business aspects using Looker, driving data-informed decision-making supporting $35 million Series A",
    ],
  },
  {
    company: "Revelio Labs",
    title: "Machine Learning Engineer",
    dates: "May 2021 – Dec 2021",
    highlights: [
      "Engineered AWS EMR + PySpark pipeline to process one million LinkedIn profiles daily",
      "Trained ensemble model to standardize employer names across the full universe of LinkedIn profiles",
    ],
  },
  {
    company: "Federal Reserve Board of Governors",
    title: "Senior Research Assistant",
    dates: "Oct 2014 – Jul 2016",
    highlights: [
      "Designed 45 TB data lake housing NYSE exchange data augmented with internally developed indicators",
    ],
  },
];

const education = [
  {
    degree: "PhD Economics",
    school: "Columbia University",
    dates: "Aug 2016 – May 2021",
  },
  {
    degree: "MSc Economics",
    school: "University College London",
    dates: "Sep 2013 – Sep 2014",
  },
  {
    degree: "BS Physics and Economics",
    school: "Rensselaer Polytechnic Institute",
    dates: "Aug 2009 – May 2013",
  },
];

const skills = [
  {
    label: "Languages",
    value: "SQL, Python, R, Julia, Golang, TypeScript, Node.js, React",
  },
  {
    label: "Experimentation & Inference",
    value:
      "A/B test design, power analysis, CUPED, stratification, uplift modeling, DML, causal forests",
  },
  {
    label: "AI Tools",
    value: "Claude Code, Codex, Amp, GitHub Copilot, Pi",
  },
  {
    label: "Data Platforms",
    value: "Snowflake, Redshift, dbt, Fivetran, AWS EMR, Spark, Lambda",
  },
  {
    label: "Visualization & BI",
    value:
      "Tableau, Looker, Sigma, executive storytelling and self-serve dashboards",
  },
  {
    label: "Event & Funnel Analytics",
    value: "attribution, conversion, retention, Google Analytics (GA4)",
  },
];
---

<BaseLayout
  title="Resume — Joe Saia"
  description="Resume of Joe Saia — engineering and analytics leader with 10+ years building data platforms and high-autonomy teams."
  wide
>
  <section class="page-intro" aria-labelledby="resume-title">
    <p class="page-eyebrow"><span>04</span> Career record</p>
    <div>
      <h1 class="page-title" id="resume-title">Résumé</h1>
      <p class="page-dek">
        Engineering and analytics leader with 10+ years building data platforms,
        production systems, and high-autonomy teams. I specialize in hiring and
        developing high-agency team members and using AI tooling to deliver
        outsized business impact.
      </p>
      <div class="resume-actions" role="group" aria-label="Download résumé">
        <a
          href="/joe_saia_resume.pdf"
          download
          class="theme-button theme-button--solid"
        >
          PDF <span aria-hidden="true">↓</span>
        </a>
        <a href="/joe_saia_resume.docx" download class="theme-button">
          DOCX <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>

  <section class="resume-contact" aria-label="Contact details">
    <div class="resume-role">
      <span>Joe Saia</span>
      <p>Engineering Leader &amp; PhD Economist</p>
    </div>
    <address>
      <span>West Orange, NJ</span>
      <a href="tel:+15185308318">518-530-8318</a>
      <a href="mailto:joe5saia@gmail.com">joe5saia@gmail.com</a>
    </address>
    <nav aria-label="Professional profiles">
      <a href="https://github.com/joe5saia/">GitHub</a>
      <a href="https://www.linkedin.com/in/joe-saia/">LinkedIn</a>
      <a href="https://joesaia.com">joesaia.com</a>
    </nav>
  </section>

  <div class="resume-layout">
    <aside class="resume-index">
      <p>On this page</p>
      <nav aria-label="Résumé sections">
        <a href="#experience"><span>01</span> Experience</a>
        <a href="#education"><span>02</span> Education</a>
        <a href="#skills"><span>03</span> Technical skills</a>
      </nav>
    </aside>

    <div class="resume-record">
      <section
        class="resume-section"
        id="experience"
        aria-labelledby="experience-title"
      >
        <header class="section-heading">
          <span>01</span>
          <h2 id="experience-title">Experience</h2>
        </header>

        <ol class="experience-list">
          {
            experience.map((role) => (
              <li>
                <article class="career-entry">
                  <p class="entry-dates">{role.dates}</p>
                  <div class="entry-copy">
                    <p class="entry-company">{role.company}</p>
                    <h3>{role.title}</h3>
                    <ul>
                      {role.highlights.map((highlight) => (
                        <li>
                          <span aria-hidden="true">—</span>
                          <p>{highlight}</p>
                        </li>
                      ))}
                    </ul>
                  </div>
                </article>
              </li>
            ))
          }
        </ol>
      </section>

      <section
        class="resume-section"
        id="education"
        aria-labelledby="education-title"
      >
        <header class="section-heading">
          <span>02</span>
          <h2 id="education-title">Education</h2>
        </header>

        <ol class="education-list">
          {
            education.map((item) => (
              <li>
                <p class="entry-dates">{item.dates}</p>
                <div>
                  <h3>{item.degree}</h3>
                  <p>{item.school}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section
        class="resume-section"
        id="skills"
        aria-labelledby="skills-title"
      >
        <header class="section-heading">
          <span>03</span>
          <h2 id="skills-title">Technical Skills</h2>
        </header>

        <dl class="skills-list">
          {
            skills.map((skill) => (
              <div>
                <dt>{skill.label}</dt>
                <dd>{skill.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .resume-actions {
    display: flex;
    margin-top: 2.25rem;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .resume-contact {
    display: grid;
    padding: 1.5rem 0;
    grid-template-columns: 1fr 1.2fr auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    border-bottom: 1px solid var(--line);
    color: var(--mist-dim);
    font-size: 0.69rem;
  }

  .resume-role span {
    color: var(--bone);
    font-family: var(--font-display);
    font-size: 1.3rem;
  }

  .resume-role p {
    margin: 0.25rem 0 0;
  }

  .resume-contact address,
  .resume-contact nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.2rem;
    font-style: normal;
  }

  .resume-contact a {
    color: var(--mist);
    text-decoration: none;
  }

  .resume-contact a:hover {
    color: var(--amber);
  }

  .resume-layout {
    display: grid;
    padding-top: clamp(4rem, 8vw, 7rem);
    grid-template-columns: minmax(9rem, 0.35fr) minmax(0, 1.65fr);
    align-items: start;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .resume-index {
    position: sticky;
    top: 7rem;
  }

  .resume-index p {
    margin: 0 0 1.25rem;
    color: var(--mist-dim);
    font-size: 0.59rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .resume-index nav {
    display: grid;
    border-top: 1px solid var(--line-bright);
  }

  .resume-index a {
    display: grid;
    padding: 0.85rem 0;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--mist);
    font-size: 0.66rem;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .resume-index a:hover {
    color: var(--amber);
  }

  .resume-index a span {
    color: var(--copper);
  }

  .resume-section {
    scroll-margin-top: 7rem;
  }

  .resume-section + .resume-section {
    margin-top: clamp(5rem, 10vw, 9rem);
  }

  .section-heading {
    display: grid;
    padding-bottom: 1.5rem;
    grid-template-columns: 3rem minmax(0, 1fr);
    align-items: baseline;
    gap: 1rem;
    border-bottom: 1px solid var(--line-bright);
  }

  .section-heading span {
    color: var(--copper);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--bone-bright);
    font-size: clamp(2.7rem, 5vw, 4.5rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .experience-list,
  .education-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .career-entry,
  .education-list > li {
    display: grid;
    padding: clamp(2rem, 5vw, 3.5rem) 0;
    grid-template-columns: minmax(8rem, 0.35fr) minmax(0, 1.65fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    border-bottom: 1px solid var(--line);
  }

  .entry-dates {
    margin: 0;
    padding-top: 0.35rem;
    color: var(--mist-dim);
    font-size: 0.62rem;
    letter-spacing: 0.09em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .entry-company {
    margin: 0;
    color: var(--copper);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .entry-copy h3,
  .education-list h3 {
    margin: 0.8rem 0 0;
    color: var(--bone-bright);
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .entry-copy > ul {
    display: grid;
    margin: 1.5rem 0 0;
    padding: 0;
    gap: 0.65rem;
    list-style: none;
  }

  .entry-copy > ul li {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr);
    gap: 0.7rem;
  }

  .entry-copy > ul span {
    color: var(--copper);
  }

  .entry-copy > ul p {
    margin: 0;
    color: var(--mist);
    font-size: 0.87rem;
    line-height: 1.62;
  }

  .education-list h3 {
    margin-top: 0;
  }

  .education-list div > p {
    margin: 0.65rem 0 0;
    color: var(--mist);
    font-size: 0.86rem;
  }

  .skills-list {
    margin: 0;
  }

  .skills-list > div {
    display: grid;
    padding: 1.5rem 0;
    grid-template-columns: minmax(10rem, 0.45fr) minmax(0, 1.55fr);
    gap: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .skills-list dt {
    color: var(--bone);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .skills-list dd {
    margin: 0;
    color: var(--mist);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  @media (max-width: 58rem) {
    .resume-contact {
      grid-template-columns: 1fr 1fr;
    }

    .resume-contact nav {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 48rem) {
    .resume-layout {
      grid-template-columns: 1fr;
    }

    .resume-index {
      position: static;
    }

    .resume-index nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .resume-index a {
      display: flex;
      padding-right: 0.5rem;
      flex-direction: column;
      border-right: 1px solid var(--line);
    }
  }

  @media (max-width: 36rem) {
    .resume-contact {
      grid-template-columns: 1fr;
    }

    .resume-contact nav {
      grid-column: auto;
    }

    .career-entry,
    .education-list > li,
    .skills-list > div {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .resume-index a {
      font-size: 0.58rem;
    }
  }
</style>
