---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../../design-system/components/Button.astro";
import Eyebrow from "../../../design-system/components/Eyebrow.astro";

const achievements = [
  "Implemented a HIPAA-compliant AI agent for initial clinical triage of cardiac device transmissions, flagging abnormal readings for clinician review, cutting triage lead time from three days to near real time and freeing 20 FTEs of capacity.",
  "Built and led a 26-person engineering, data, QA, IT, and Salesforce organization at Rhythm Management Group, reporting to the CEO.",
  "Improved platform uptime from 85% to over 99% and moved releases from quarterly to biweekly within three months at Rhythm.",
  "Reduced cloud spend 30% through backend consolidation while improving system performance at Rhythm.",
];

const experience = [
  {
    company: "Unhistoric Acts Foundation",
    title: "President & Founder",
    dates: "Mar 2026 – Present",
    highlights: [
      "Founded a 501(c)(3) nonprofit to build Town Crier, a civic-tech platform that makes local government records (agendas, minutes, ordinances) usable by residents, journalists, and AI agents.",
      "Designed an AI-native engineering process and serve as its architect and final reviewer, with coding agents building against written specs, automating tests, and validating their work end to end.",
      "Shipped an MCP server backed by a retrieval-augmented generation (RAG) pipeline, so AI agents can search, retrieve, and cite local government records they could not previously reach.",
      "Continuously test frontier models and agent tooling, and fold what works into the development process.",
    ],
  },
  {
    company: "Rhythm Management Group",
    title: "Head of Engineering",
    dates: "May 2024 – Mar 2026",
    highlights: [
      "Private-equity-backed remote cardiac monitoring company. Reported to the CEO and led a fully in-house, 26-person organization across product and platform engineering, QA, support, IT, data analysis, and Salesforce, spanning the United States, Latin America, Europe, and Turkey.",
      "Managed eight direct reports: a Director of Engineering; a Senior Manager over the product, QA, platform, and support teams; three senior engineers; a data analyst; a Salesforce analyst; and an IT manager.",
      "Reorganized a legacy waterfall team around ownership and iterative delivery, shortening customer response times and product decision cycles. Raised platform uptime from 85% to over 99% and moved releases from quarterly to biweekly.",
      "Implemented an AI agent for first-pass clinical triage that flags abnormal cardiac device transmissions for clinician review, cutting lead time from three days to near real time and freeing 20 FTEs of capacity.",
      "Co-owned the Snowflake, Fivetran, and Sigma BI stack with the VP of Finance, moving executive and operational reporting to self-service dashboards with shared metric definitions.",
      "Personally built Python ETL from the revenue cycle management vendor into Salesforce and Snowflake, automating claims reconciliation and measuring claims funnel performance.",
      "Incorporated Claude Code into the engineering process, along with AI PR reviews and shared skills.",
    ],
  },
  {
    company: "Perry Health",
    title: "Senior Manager of Data & Engineering",
    dates: "May 2022 – May 2024",
    highlights: [
      "Venture-backed healthtech company with a $35M Series A. Reported directly to the COO, led engineers and data scientists across New York and Europe, and owned the EHR web application and data infrastructure.",
      "Built the acquisition-to-enrollment funnel with RudderStack, Google Analytics, and Tableau, instrumenting events and running A/B tests to improve conversion.",
      "Built the claims processing pipeline that let a two-person revenue team manage ~$1.5M annually at a 74% collections rate, above the industry average for RPM operations.",
      "Shipped integrations with Abbott, Dexcom, and Surescripts to improve clinical decision-making.",
    ],
  },
  {
    company: "Perry Health",
    title: "Data Scientist",
    dates: "Dec 2021 – May 2022",
    highlights: [
      "Migrated Python ETLs to Fivetran and dbt SQL on Amazon Redshift, enabling faster iteration.",
      "Maintained company-wide Looker reporting to support business decisions and the $35M Series A raise.",
    ],
  },
  {
    company: "Revelio Labs",
    title: "Machine Learning Engineer",
    dates: "May 2021 – Dec 2021",
    highlights: [
      "Engineered an AWS EMR and PySpark pipeline processing one million LinkedIn profiles daily.",
      "Trained an ensemble model to standardize employer names across LinkedIn profiles.",
    ],
  },
  {
    company: "Federal Reserve Board of Governors",
    title: "Senior Research Assistant",
    dates: "Oct 2014 – Jul 2016",
    highlights: [
      "Designed a 45 TB data lake of NYSE trade data augmented with internally developed indicators.",
    ],
  },
];

const education = [
  {
    degree: "PhD Economics",
    school: "Columbia University",
    dates: "Aug 2016 – May 2021",
  },
  {
    degree: "MSc Economics",
    school: "University College London",
    dates: "Sep 2013 – Sep 2014",
  },
  {
    degree: "BS Physics & Economics",
    school: "Rensselaer Polytechnic Institute",
    dates: "Aug 2009 – May 2013",
  },
];

const skills = [
  {
    label: "Languages and frameworks",
    value: "Python, SQL, R, Julia, Go, TypeScript, Node.js, React, NestJS",
  },
  {
    label: "AI",
    value:
      "AI-native development / coding agents, MCP, RAG, Claude Code, Codex, Amp",
  },
  {
    label: "Data Platforms",
    value: "Snowflake, Redshift, dbt, Fivetran, AWS EMR, Spark, Lambda",
  },
  {
    label: "BI and product analytics",
    value:
      "Tableau, Looker, Sigma, executive reporting, self-service dashboards, attribution, conversion and retention analysis, Google Analytics 4",
  },
];
---

<BaseLayout
  title="Resume — Joe Saia"
  description="Resume of Joe Saia — engineering leader and PhD economist building AI-native engineering organizations."
  wide
>
  <section class="page-intro" aria-labelledby="resume-title">
    <Eyebrow index="04">Career record</Eyebrow>
    <div>
      <h1 class="page-title" id="resume-title">Résumé</h1>
      <p class="page-dek">
        Engineering leader and PhD economist who builds AI-native engineering
        organizations. I have shipped production AI agents in healthcare and
        scaled a 26-person team across engineering, data, QA, and IT, with deep
        experience in EHR integrations, clinical device data, and claims
        processing.
      </p>
      <div class="resume-actions" role="group" aria-label="Download résumé">
        <Button href="/joe_saia_resume.pdf" download variant="primary">
          PDF
          <span slot="icon">↓</span>
        </Button>
      </div>
    </div>
  </section>

  <section class="resume-contact" aria-label="Contact details">
    <div class="resume-role">
      <span>Joe Saia</span>
      <p>Engineering Leader &amp; PhD Economist</p>
    </div>
    <address>
      <span>West Orange, NJ</span>
      <a href="tel:+15185308318">518-530-8318</a>
      <a href="mailto:joe5saia@gmail.com">joe5saia@gmail.com</a>
    </address>
    <nav aria-label="Professional profiles">
      <a href="https://github.com/joe5saia/">GitHub</a>
      <a href="https://www.linkedin.com/in/joe-saia/">LinkedIn</a>
      <a href="https://joesaia.com">joesaia.com</a>
    </nav>
  </section>

  <div class="resume-layout">
    <aside class="resume-index">
      <p>On this page</p>
      <nav aria-label="Résumé sections">
        <a href="#achievements"><span>01</span> Key achievements</a>
        <a href="#experience"><span>02</span> Experience</a>
        <a href="#education"><span>03</span> Education</a>
        <a href="#skills"><span>04</span> Skills</a>
      </nav>
    </aside>

    <div class="resume-record">
      <section
        class="resume-section"
        id="achievements"
        aria-labelledby="achievements-title"
      >
        <header class="section-heading">
          <span>01</span>
          <h2 id="achievements-title">Key Achievements</h2>
        </header>
        <ul class="achievements-list">
          {achievements.map((achievement) => <li>{achievement}</li>)}
        </ul>
      </section>

      <section
        class="resume-section"
        id="experience"
        aria-labelledby="experience-title"
      >
        <header class="section-heading">
          <span>02</span>
          <h2 id="experience-title">Experience</h2>
        </header>

        <ol class="experience-list">
          {
            experience.map((role) => (
              <li>
                <article class="career-entry">
                  <p class="entry-dates">{role.dates}</p>
                  <div class="entry-copy">
                    <p class="entry-company">{role.company}</p>
                    <h3>{role.title}</h3>
                    <ul>
                      {role.highlights.map((highlight) => (
                        <li>
                          <span aria-hidden="true">—</span>
                          <p>{highlight}</p>
                        </li>
                      ))}
                    </ul>
                  </div>
                </article>
              </li>
            ))
          }
        </ol>
      </section>

      <section
        class="resume-section"
        id="education"
        aria-labelledby="education-title"
      >
        <header class="section-heading">
          <span>03</span>
          <h2 id="education-title">Education</h2>
        </header>

        <ol class="education-list">
          {
            education.map((item) => (
              <li>
                <p class="entry-dates">{item.dates}</p>
                <div>
                  <h3>{item.degree}</h3>
                  <p>{item.school}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section
        class="resume-section"
        id="skills"
        aria-labelledby="skills-title"
      >
        <header class="section-heading">
          <span>04</span>
          <h2 id="skills-title">Skills</h2>
        </header>

        <dl class="skills-list">
          {
            skills.map((skill) => (
              <div>
                <dt>{skill.label}</dt>
                <dd>{skill.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .resume-actions {
    display: flex;
    margin-top: 2.25rem;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .resume-contact {
    display: grid;
    padding: 1.5rem 0;
    grid-template-columns: 1fr 1.2fr auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    border-bottom: 1px solid var(--line);
    color: var(--mist-dim);
    font-size: 0.69rem;
  }

  .resume-role span {
    color: var(--bone);
    font-family: var(--font-display);
    font-size: 1.3rem;
  }

  .resume-role p {
    margin: 0.25rem 0 0;
  }

  .resume-contact address,
  .resume-contact nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.2rem;
    font-style: normal;
  }

  .resume-contact a {
    color: var(--mist);
    text-decoration: none;
  }

  .resume-contact a:hover {
    color: var(--amber);
  }

  .resume-layout {
    display: grid;
    padding-top: clamp(4rem, 8vw, 7rem);
    grid-template-columns: minmax(9rem, 0.35fr) minmax(0, 1.65fr);
    align-items: start;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .resume-index {
    position: sticky;
    top: 7rem;
  }

  .resume-index p {
    margin: 0 0 1.25rem;
    color: var(--mist-dim);
    font-size: 0.59rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .resume-index nav {
    display: grid;
    border-top: 1px solid var(--line-bright);
  }

  .resume-index a {
    display: grid;
    padding: 0.85rem 0;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--mist);
    font-size: 0.66rem;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .resume-index a:hover {
    color: var(--amber);
  }

  .resume-index a span {
    color: var(--copper);
  }

  .resume-section {
    scroll-margin-top: 7rem;
  }

  .resume-section + .resume-section {
    margin-top: clamp(5rem, 10vw, 9rem);
  }

  .section-heading {
    display: grid;
    padding-bottom: 1.5rem;
    grid-template-columns: 3rem minmax(0, 1fr);
    align-items: baseline;
    gap: 1rem;
    border-bottom: 1px solid var(--line-bright);
  }

  .section-heading span {
    color: var(--copper);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--bone-bright);
    font-size: clamp(2.7rem, 5vw, 4.5rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .achievements-list {
    display: grid;
    margin: 0;
    padding: 1.5rem 0 0 1.25rem;
    gap: 1rem;
    color: var(--mist);
    font-size: 0.87rem;
    line-height: 1.62;
  }

  .achievements-list li::marker {
    color: var(--copper);
  }

  .experience-list,
  .education-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .career-entry,
  .education-list > li {
    display: grid;
    padding: clamp(2rem, 5vw, 3.5rem) 0;
    grid-template-columns: minmax(8rem, 0.35fr) minmax(0, 1.65fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    border-bottom: 1px solid var(--line);
  }

  .entry-dates {
    margin: 0;
    padding-top: 0.35rem;
    color: var(--mist-dim);
    font-size: 0.62rem;
    letter-spacing: 0.09em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .entry-company {
    margin: 0;
    color: var(--copper);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .entry-copy h3,
  .education-list h3 {
    margin: 0.8rem 0 0;
    color: var(--bone-bright);
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .entry-copy > ul {
    display: grid;
    margin: 1.5rem 0 0;
    padding: 0;
    gap: 0.65rem;
    list-style: none;
  }

  .entry-copy > ul li {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr);
    gap: 0.7rem;
  }

  .entry-copy > ul span {
    color: var(--copper);
  }

  .entry-copy > ul p {
    margin: 0;
    color: var(--mist);
    font-size: 0.87rem;
    line-height: 1.62;
  }

  .education-list h3 {
    margin-top: 0;
  }

  .education-list div > p {
    margin: 0.65rem 0 0;
    color: var(--mist);
    font-size: 0.86rem;
  }

  .skills-list {
    margin: 0;
  }

  .skills-list > div {
    display: grid;
    padding: 1.5rem 0;
    grid-template-columns: minmax(10rem, 0.45fr) minmax(0, 1.55fr);
    gap: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .skills-list dt {
    color: var(--bone);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .skills-list dd {
    margin: 0;
    color: var(--mist);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  @media (max-width: 58rem) {
    .resume-contact {
      grid-template-columns: 1fr 1fr;
    }

    .resume-contact nav {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 48rem) {
    .resume-layout {
      grid-template-columns: 1fr;
    }

    .resume-index {
      position: static;
    }

    .resume-index nav {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .resume-index a {
      display: flex;
      padding-right: 0.5rem;
      flex-direction: column;
      border-right: 1px solid var(--line);
    }
  }

  @media (max-width: 36rem) {
    .resume-contact {
      grid-template-columns: 1fr;
    }

    .resume-contact nav {
      grid-column: auto;
    }

    .career-entry,
    .education-list > li,
    .skills-list > div {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .resume-index a {
      font-size: 0.58rem;
    }
  }
</style>
