---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import Eyebrow from "../../../design-system/components/Eyebrow.astro";
import { getCollection } from "astro:content";

const posts = (
  await getCollection(
    "writing",
    ({ data }) => import.meta.env.DEV || !data.draft,
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Writing — Joe Saia"
  description="Articles on data engineering, analytics leadership, and AI-augmented development."
  wide
>
  <section class="page-intro" aria-labelledby="writing-title">
    <Eyebrow index="03">Field notes</Eyebrow>
    <div>
      <h1 class="page-title" id="writing-title">Writing</h1>
      <p class="page-dek">
        Notes on technical leadership, data systems, applied AI, and the work of
        building organizations that can take on difficult problems.
      </p>
    </div>
  </section>

  {
    posts.length > 0 ? (
      <section class="writing-ledger" aria-labelledby="archive-title">
        <div class="ledger-heading">
          <h2 id="archive-title">The archive</h2>
          <p>
            {posts.length.toString().padStart(2, "0")}{" "}
            {posts.length === 1 ? "entry" : "entries"}
          </p>
        </div>
        <ol class="post-list">
          {posts.map((post, index) => (
            <li>
              <PostCard
                title={post.data.title}
                date={post.data.date}
                summary={post.data.summary}
                slug={post.id}
                featured={post.data.featured}
                index={index + 1}
              />
            </li>
          ))}
        </ol>
      </section>
    ) : (
      <p class="empty-state">No posts yet. Check back soon.</p>
    )
  }
</BaseLayout>

<style>
  .writing-ledger {
    padding-top: clamp(3.5rem, 7vw, 6.5rem);
  }

  .ledger-heading {
    display: flex;
    padding-bottom: 1rem;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid var(--line-bright);
  }

  .ledger-heading h2,
  .ledger-heading p {
    margin: 0;
  }

  .ledger-heading h2 {
    color: var(--bone);
    font-family: var(--font-sans);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .ledger-heading p {
    color: var(--mist-dim);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .empty-state {
    margin-top: 4rem;
    color: var(--mist);
  }
</style>
