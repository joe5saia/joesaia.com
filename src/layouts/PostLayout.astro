---
import BaseLayout from "./BaseLayout.astro";
import SurvivalTo80Chart from "../components/SurvivalTo80Chart.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"writing">;
}

const { post } = Astro.props;
const { title, date, summary, tags, visualization } = post.data;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const defaultImage = new URL("/social-card.png", Astro.site).toString();
const authorId = `${new URL("/", Astro.site).toString()}#person`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${canonical}#article`,
  headline: title,
  description: summary,
  datePublished: date.toISOString(),
  url: canonical,
  mainEntityOfPage: canonical,
  image: defaultImage,
  inLanguage: "en-US",
  author: {
    "@type": "Person",
    "@id": authorId,
    name: "Joe Saia",
    url: new URL("/", Astro.site).toString(),
  },
  keywords: tags ?? [],
};
---

<BaseLayout
  title={`${title} — Joe Saia`}
  description={summary}
  type="article"
  wide
>
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    {tags?.map((tag: string) => <meta property="article:tag" content={tag} />)}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(articleJsonLd)}
    />
  </Fragment>

  <article class="article-page">
    <a class="back-link" href="/writing/">
      <span aria-hidden="true">←</span> All writing
    </a>

    <header class="article-header">
      <div class="article-meta">
        <p>Field note</p>
        <time datetime={date.toISOString()}>
          {
            date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
              timeZone: "UTC",
            })
          }
        </time>
      </div>

      <div class="article-heading">
        <h1>{title}</h1>
        {visualization && <p class="article-summary">{summary}</p>}
        {
          tags && tags.length > 0 && (
            <div class="article-tags" aria-label="Topics">
              {tags.map((tag: string) => (
                <span class="theme-tag">{tag}</span>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div class="article-body">
      <aside aria-hidden="true">
        <span>Joe Saia</span>
        <span class="rail-line"></span>
        <span>Technical leadership</span>
      </aside>
      <div class="prose max-w-none">
        {visualization === "survival-to-80" && <SurvivalTo80Chart />}
        <slot />
      </div>
    </div>

    <footer class="article-footer">
      <span aria-hidden="true">◆</span>
      <a href="/writing/">Return to the archive</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--mist);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 160ms ease;
  }

  .back-link:hover {
    color: var(--amber);
  }

  .back-link span {
    color: var(--copper);
    font-size: 1rem;
  }

  .article-header {
    display: grid;
    padding: clamp(3rem, 7vw, 6.25rem) 0 clamp(3.5rem, 8vw, 7rem);
    grid-template-columns: minmax(8rem, 0.38fr) minmax(0, 1.62fr);
    gap: clamp(2rem, 7vw, 7rem);
    border-bottom: 1px solid var(--line-bright);
  }

  .article-meta {
    padding-top: 0.75rem;
  }

  .article-meta p,
  .article-meta time {
    display: block;
    margin: 0;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .article-meta p {
    margin-bottom: 1.1rem;
    color: var(--copper);
    font-weight: 700;
    letter-spacing: 0.19em;
  }

  .article-meta time {
    max-width: 8rem;
    color: var(--mist-dim);
  }

  .article-heading h1,
  .article-summary {
    margin: 0;
  }

  .article-heading h1 {
    max-width: 60rem;
    overflow-wrap: anywhere;
    color: var(--bone-bright);
    font-size: clamp(3.25rem, 7vw, 7.1rem);
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .article-summary {
    max-width: 46rem;
    margin-top: 2rem;
    color: var(--mist);
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.7;
  }

  .article-tags {
    display: flex;
    margin-top: 2.25rem;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .article-body {
    display: grid;
    max-width: 66rem;
    margin: 0 auto;
    padding-top: clamp(3.5rem, 8vw, 7rem);
    grid-template-columns: 8rem minmax(0, 49rem);
    gap: clamp(2rem, 6vw, 6rem);
  }

  .article-body aside {
    display: flex;
    min-height: 22rem;
    padding-top: 0.45rem;
    align-items: center;
    align-self: start;
    color: var(--mist-dim);
    flex-direction: column;
    font-size: 0.55rem;
    letter-spacing: 0.15em;
    line-height: 1.45;
    text-align: center;
    text-transform: uppercase;
  }

  .rail-line {
    width: 1px;
    min-height: 8rem;
    margin: 1rem 0;
    background: linear-gradient(var(--copper), rgba(212, 122, 59, 0.08));
    flex: 1;
  }

  .article-footer {
    display: flex;
    max-width: 49rem;
    margin: clamp(4rem, 8vw, 7rem) auto 0;
    padding-top: 1.5rem;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--line-bright);
  }

  .article-footer span {
    color: var(--copper);
    font-size: 0.55rem;
  }

  .article-footer a {
    color: var(--mist);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .article-footer a:hover {
    color: var(--amber);
  }

  @media (max-width: 52rem) {
    .article-body {
      grid-template-columns: 1fr;
    }

    .article-body aside {
      display: none;
    }
  }

  @media (max-width: 44rem) {
    .article-header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .article-meta {
      padding-top: 0;
    }

    .article-meta time {
      max-width: none;
    }

    .article-heading h1 {
      font-size: clamp(3rem, 15vw, 4.8rem);
    }
  }
</style>
