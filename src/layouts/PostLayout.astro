---
import BaseLayout from "./BaseLayout.astro";
import SurvivalTo80Chart from "../components/SurvivalTo80Chart.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"writing">;
}

const { post } = Astro.props;
const { title, date, summary, tags, visualization } = post.data;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const defaultImage = new URL("/social-card.png", Astro.site).toString();
const authorId = `${new URL("/", Astro.site).toString()}#person`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${canonical}#article`,
  headline: title,
  description: summary,
  datePublished: date.toISOString(),
  url: canonical,
  mainEntityOfPage: canonical,
  image: defaultImage,
  inLanguage: "en-US",
  author: {
    "@type": "Person",
    "@id": authorId,
    name: "Joe Saia",
    url: new URL("/", Astro.site).toString(),
  },
  keywords: tags ?? [],
};
---

<BaseLayout title={`${title} — Joe Saia`} description={summary} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    {tags?.map((tag: string) => <meta property="article:tag" content={tag} />)}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(articleJsonLd)}
    />
  </Fragment>

  <article class="prose max-w-none">
    <header class="mb-8 not-prose">
      <time class="text-sm text-accent" datetime={date.toISOString()}>
        {
          date.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
            timeZone: "UTC",
          })
        }
      </time>
      <h1 class="text-3xl font-bold mt-2 mb-4 text-text-heading">{title}</h1>
      {
        tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag: string) => (
              <span class="px-2 py-1 bg-accent-subtle text-accent text-xs rounded">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </header>
    {
      visualization && (
        <p class="not-prose mb-8 text-lg leading-relaxed text-text-secondary">
          {summary}
        </p>
      )
    }
    {visualization === "survival-to-80" && <SurvivalTo80Chart />}
    <slot />
  </article>
</BaseLayout>
